# Copy to terraform.tfvars and fill in. The file is git-ignored.
region      = "us-east-1"
environment = "staging"
alert_email = "you@example.com"

# Only uncomment what differs from the defaults in main.tf: project, region,
# image_tag, vector_backend, qdrant_url, ollama_base_url, ollama_model, embedding_model,
# lambda_memory_mb, lambda_timeout_s, reserved_concurrency,
# function_url_auth_type, monthly_budget_usd, github_repo, github_branch,
# github_oidc_thumbprint, create_github_oidc_provider.

# The default is localhost, which Lambda cannot reach: point this at an
# endpoint that is reachable from AWS and that asks for a token.
# ollama_base_url = "https://ollama.example.com"
# ollama_model    = "llama3.1:8b"

# AWS_IAM (default) keeps the endpoint private. NONE makes it public: anyone
# with the URL can then spend model time on the Ollama host.
# function_url_auth_type = "AWS_IAM"

# AWS allows one token.actions.githubusercontent.com provider per account. Set
# this to false when the account already has one, or apply fails with
# EntityAlreadyExists.
# create_github_oidc_provider = false

# Placeholders: replace the value after apply, so real credentials never reach
# a .tfvars file. Leave OLLAMA_API_KEY as "" when the endpoint needs no token.
#   aws ssm put-parameter --name <app_secret_parameter> --type SecureString \
#     --value file://secret.json --overwrite
# rag_secret_json = <<-JSON
#   {
#     "QDRANT_API_KEY": "...",
#     "OLLAMA_API_KEY": "",
#     "MLFLOW_TRACKING_URI": "..."
#   }
# JSON
