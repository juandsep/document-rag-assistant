": "code", "source_file": "infra/main.tf", "source_location": "L54", "attributes": {"description": "Retriever the chain talks to: qdrant (deployed) or local (development only, the image ships no index).", "type": "string", "default": "qdrant"}}, {"id": "terraform_users_sepulveda_code_portfolio_document_rag_assistant_infra_a441a3909728ef56_var_qdrant_url", "label": "var.qdrant_url", "file_type": "code", "source_file": "infra/main.tf", "source_location": "L65", "attributes": {"description": "Qdrant Cloud cluster URL (https://<id>.<region>.aws.cloud.qdrant.io). Its API key goes in the SecureString, not here.", "type": "string", "default": ""}}, {"id": "terraform_users_sepulveda_code_portfolio_document_rag_assistant_infra_a441a3909728ef56_var_ollama_base_url", "label": "var.ollama_base_url", "file_type": "code", "source_file": "infra/main.tf", "source_location": "L71", "attributes": {"description": "Ollama HTTP API the chain calls. Must be reachable from Lambda: the localhost default only works for a local run.", "type": "string", "default": "http://localhost:11434"}}, {"id": "terraform_users_sepulveda_code_portfolio_document_rag_assistant_infra_a441a3909728ef56_var_ollama_model", "label": "var.ollama_model", "file_type": "code", "source_file": "infra/main.tf", "source_location": "L77", "attributes": {"description": "Model the chain generates with.", "type": "string", "default": "llama3.1:8b"}}, {"id": "terraform_users_sepulveda_code_portfolio_document_rag_assistant_infra_a441a3909728ef56_var_embedding_model", "label": "var.embedding_model", "file_type": "code", "source_file": "infra/main.tf", "source_location": "L83", "attributes": {"description": "Embedding model served by the same Ollama API, used at index time and at query time.", "type": "string", "default": "nomic-embed-text"}}, {"id": "terraform_users_sepulveda_code_portfolio_document_rag_assistant_infra_a441a3909728ef56_var_lambda_memory_mb", "label": "var.lambda_memory_mb", "file_type": "code", "source_file": "