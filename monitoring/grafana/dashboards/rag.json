          "expression": "filter event = \"rag_query\" | stats pct(latency_ms, 50) as total_p50, pct(latency_ms, 95) as total_p95, pct(retrieval_ms, 95) as retrieval_p95, pct(generation_ms, 95) as generation_p95 by bin(5m)",
